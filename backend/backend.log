      ) AS [t9] ON [t5].[Id6] = [t9].[VisitAnalysisId]
      ORDER BY [t5].[Id], [t5].[Id0], [t5].[Id1], [t5].[Id2], [t5].[Id3], [t5].[Id4], [t5].[Id5], [t5].[Id6], [t6].[Id], [t6].[Id0], [t6].[Id1]
