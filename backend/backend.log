          SELECT [v1].[Id], [v1].[CreatedAt], [v1].[DeletedAt], [v1].[DeletedByUserId], [v1].[EvidenceNote], [v1].[IsDeleted], [v1].[RubricStandardId], [v1].[Score], [v1].[UpdatedAt], [v1].[VisitId], [t7].[Id] AS [Id0], [t7].[Code], [t7].[DeletedAt] AS [DeletedAt0], [t7].[DeletedByUserId] AS [DeletedByUserId0], [t7].[IsDeleted] AS [IsDeleted0], [t7].[RubricDomainId], [t7].[SortOrder], [t7].[TextAr], [t8].[Id] AS [Id1], [t8].[Code] AS [Code0], [t8].[DeletedAt] AS [DeletedAt1], [t8].[DeletedByUserId] AS [DeletedByUserId1], [t8].[IsDeleted] AS [IsDeleted1], [t8].[NameAr], [t8].[RubricVersionId], [t8].[SortOrder] AS [SortOrder0]
          FROM [VisitScores] AS [v1]
          INNER JOIN (
              SELECT [r0].[Id], [r0].[Code], [r0].[DeletedAt], [r0].[DeletedByUserId], [r0].[IsDeleted], [r0].[RubricDomainId], [r0].[SortOrder], [r0].[TextAr]
              FROM [RubricStandards] AS [r0]
