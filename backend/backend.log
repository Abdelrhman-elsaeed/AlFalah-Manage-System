          FROM [RubricDomains] AS [r]
          WHERE [r].[IsDeleted] = CAST(0 AS bit)
      ) AS [t0] ON [t].[DomainId] = [t0].[Id]
      INNER JOIN (
          SELECT [u].[Id], [u].[FirstName], [u].[LastName]
          FROM [Users] AS [u]
          WHERE [u].[IsDeleted] = CAST(0 AS bit)
      ) AS [t1] ON [p].[CreatedByUserId] = [t1].[Id]
      WHERE [p].[IsDeleted] = CAST(0 AS bit) AND [t].[VisitId] = @__visitId_0
      ORDER BY [p].[FollowDate] DESC, [p].[Id] DESC
