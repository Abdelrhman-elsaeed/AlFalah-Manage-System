              SELECT [r1].[Id], [r1].[Code], [r1].[DeletedAt], [r1].[DeletedByUserId], [r1].[IsDeleted], [r1].[NameAr], [r1].[RubricVersionId], [r1].[SortOrder]
              FROM [RubricDomains] AS [r1]
              WHERE [r1].[IsDeleted] = CAST(0 AS bit)
          ) AS [t7] ON [t6].[RubricDomainId] = [t7].[Id]
          WHERE [v1].[IsDeleted] = CAST(0 AS bit)
      ) AS [t5] ON [t4].[Id] = [t5].[VisitId]
      LEFT JOIN (
          SELECT [v2].[Id], [v2].[AverageScore], [v2].[DeletedAt], [v2].[DeletedByUserId], [v2].[DomainCode], [v2].[DomainNameAr], [v2].[IsDeleted], [v2].[RubricDomainId], [v2].[VisitAnalysisId]
          FROM [VisitDomainAverages] AS [v2]
          WHERE [v2].[IsDeleted] = CAST(0 AS bit)
      ) AS [t8] ON [t4].[Id4] = [t8].[VisitAnalysisId]
      ORDER BY [t4].[Id], [t4].[Id0], [t4].[Id1], [t4].[Id2], [t4].[Id3], [t4].[Id4], [t5].[Id], [t5].[Id0], [t5].[Id1]
