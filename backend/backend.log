      Compiling query expression: 
      'DbSet<PlanFollowUp>()
          .AsNoTracking()
          .Where(followUp => followUp.ImprovementPlan.VisitId == __visitId_0)
          .OrderByDescending(followUp => followUp.FollowDate)
          .ThenByDescending(followUp => followUp.Id)
          .Select(followUp => new VisitPlanFollowUpDto{ 
              PlanId = followUp.ImprovementPlanId, 
              DomainNameAr = followUp.ImprovementPlan.Domain != null ? followUp.ImprovementPlan.Domain.NameAr : null, 
              Goal = followUp.ImprovementPlan.Goal, 
              FollowUpId = followUp.Id, 
              FollowDate = followUp.FollowDate, 
              ProgressNote = followUp.ProgressNote, 
              EvidenceNote = followUp.EvidenceNote, 
              ProgressScore = followUp.ProgressScore, 
              CreatedByFullName = followUp.CreatedByUser.FirstName + " " + followUp.CreatedByUser.LastName 
          }
          )'
dbug: Microsoft.EntityFrameworkCore.Query[10107]
      Generated query execution expression: 
      'queryContext => new SingleQueryingEnumerable<VisitPlanFollowUpDto>(
          (RelationalQueryContext)queryContext, 
          RelationalCommandCache.QueryExpression(
              Projection Mapping:
                  PlanId -> 0
                  DomainNameAr -> 1
                  Goal -> 2
                  FollowUpId -> 3
                  FollowDate -> 4
                  ProgressNote -> 5
                  EvidenceNote -> 6
                  ProgressScore -> 7
                  CreatedByFullName -> 8
              SELECT p.ImprovementPlanId AS PlanId, t0.NameAr AS DomainNameAr, t.Goal, p.Id AS FollowUpId, p.FollowDate, p.ProgressNote, p.EvidenceNote, p.ProgressScore, (t1.FirstName + N' ') + t1.LastName AS CreatedByFullName
              FROM PlanFollowUps AS p
              INNER JOIN 
              (
                  SELECT i.Id, i.DomainId, i.Goal, i.VisitId
                  FROM ImprovementPlans AS i
                  WHERE Not(i.IsDeleted)
              ) AS t ON p.ImprovementPlanId == t.Id
              LEFT JOIN 
              (
                  SELECT r.Id, r.NameAr
                  FROM RubricDomains AS r
                  WHERE Not(r.IsDeleted)
              ) AS t0 ON t.DomainId == t0.Id
              INNER JOIN 
              (
                  SELECT u.Id, u.FirstName, u.LastName
                  FROM Users AS u
                  WHERE Not(u.IsDeleted)
              ) AS t1 ON p.CreatedByUserId == t1.Id
              WHERE Not(p.IsDeleted) && (t.VisitId == @__visitId_0)
              ORDER BY p.FollowDate DESC, p.Id DESC), 
          null, 
          Func<QueryContext, DbDataReader, ResultContext, SingleQueryResultCoordinator, VisitPlanFollowUpDto>, 
          AlFalah.Infrastructure.Data.AlFalahDbContext, 
          False, 
          False, 
          True
      )'
