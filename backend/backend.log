      SELECT [p].[ImprovementPlanId] AS [PlanId], [t0].[NameAr] AS [DomainNameAr], [t].[Goal], [p].[Id] AS [FollowUpId], [p].[FollowDate], [p].[ProgressNote], [p].[EvidenceNote], [p].[ProgressScore], [t1].[FirstName] + N' ' + [t1].[LastName] AS [CreatedByFullName]
