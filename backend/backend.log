          LEFT JOIN (
              SELECT [v0].[Id], [v0].[ComputedAt], [v0].[DeletedAt], [v0].[DeletedByUserId], [v0].[ImprovementAreasJson], [v0].[IsDeleted], [v0].[OverallScore], [v0].[PerformanceLevelAr], [v0].[PriorityStandardsJson], [v0].[StrengthsJson], [v0].[VisitId]
