          FROM [VisitScores] AS [v1]
          INNER JOIN (
              SELECT [r0].[Id], [r0].[Code], [r0].[DeletedAt], [r0].[DeletedByUserId], [r0].[IsDeleted], [r0].[RubricDomainId], [r0].[SortOrder], [r0].[TextAr]
              FROM [RubricStandards] AS [r0]
              WHERE [r0].[IsDeleted] = CAST(0 AS bit)
          ) AS [t7] ON [v1].[RubricStandardId] = [t7].[Id]
          INNER JOIN (
              SELECT [r1].[Id], [r1].[Code], [r1].[DeletedAt], [r1].[DeletedByUserId], [r1].[IsDeleted], [r1].[NameAr], [r1].[RubricVersionId], [r1].[SortOrder]
              FROM [RubricDomains] AS [r1]
