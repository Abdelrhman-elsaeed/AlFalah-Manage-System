<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AlFalah.Application\AlFalah.Application.csproj" />
    <ProjectReference Include="..\AlFalah.Domain\AlFalah.Domain.csproj" />
    <ProjectReference Include="..\AlFalah.Shared\AlFalah.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.2.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Identity.Web" Version="4.13.2" />
    <!-- Phase 6 / Stage 1: server-side Arabic PDF rendering (QuestPDF Community license) -->
    <PackageReference Include="QuestPDF" Version="2024.3.4" />
    <!-- Phase 6 / Stage 2: server-side QR code (PNG bytes fed to QuestPDF) -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
    <!-- Phase 9 dashboards: ClosedXML for server-side Excel export (matches docs/09 §Dashboard.Excel).
         Note: previously missing from the csproj on the working tree — D-74 added it back so the
         build is green (DashboardService.cs was already importing ClosedXML.Excel). -->
    <PackageReference Include="ClosedXML" Version="0.102.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Phase 6 / Stage 1: Amiri (Arabic-capable) font shipped as an embedded content asset
         so the generated PDF does not depend on system fonts for correct Arabic
         RTL / shaping. -->
    <None Update="Assets\Fonts\Amiri-Regular.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Update="Assets\Fonts\Amiri-Bold.ttf">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Reuse the official application logo in server-generated PDF headers. -->
    <None Include="..\..\frontend\src\assets\Logo.png"
          Link="Assets\Logo.png"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
