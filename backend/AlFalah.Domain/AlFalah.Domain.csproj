<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\AlFalah.Shared\AlFalah.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MediatR.Contracts" Version="2.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Required so Domain types that inherit from Microsoft.AspNetCore.Identity.* (ApplicationUser)
         can be loaded by downstream projects that reference the Domain assembly.
         Without this, AlFalah.Domain.dll fails with FileLoadException → downstream consumers
         (Infrastructure, Api) see the domain as empty (no InstructorProfile.Stage,
         no DbContext.InstructorClasses, etc.) — pre-existing baseline gap that D-74 fixes. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
